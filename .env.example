# Copy to ~/.config/engineering-orchestrator/.env (or export in your shell).
# Never commit real credentials. Prefer `orc config set-secret` which uses the OS keychain.

# --- Jira ---
ORC_JIRA_BASE_URL=https://your-domain.atlassian.net
ORC_JIRA_EMAIL=you@example.com
ORC_JIRA_API_TOKEN=
# Optional: default project key used when an issue key is not fully qualified
ORC_JIRA_DEFAULT_PROJECT=MOB

# --- Git hosting ---
ORC_GIT_PROVIDER=github            # github | gitlab | none
ORC_GITHUB_TOKEN=
ORC_GIT_DEFAULT_BASE_BRANCH=main

# --- Engine ---
ORC_ENGINE=claude_code             # claude_code | agent_sdk | mock
ORC_ENGINE_MODEL=claude-opus-4
ORC_ENGINE_TIMEOUT=900

# --- Behaviour ---
ORC_AUTO_APPROVE=false             # never set true on shared machines
ORC_LOG_LEVEL=INFO
